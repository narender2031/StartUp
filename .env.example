# HTTP runtime
PORT=3000
# Set to false locally. In deployment, set to the exact proxy hop count (for example 1)
# or a comma-separated list of trusted proxy subnets/addresses.
TRUST_PROXY=false

# SMTP provider. Replace placeholders in the deployment environment; do not commit secrets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact-smtp-user
SMTP_PASS=contact-smtp-password

# Mail routing. CONTACT_FROM_EMAIL is the authenticated/domain-owned sender.
# Visitor email addresses are used as Reply-To only.
CONTACT_FROM_EMAIL=website@example.com
CONTACT_TO_EMAIL=contact@example.com
